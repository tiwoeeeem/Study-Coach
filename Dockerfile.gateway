# ─── Stage 1: Build React frontend ───
FROM node:20-slim AS frontend-build

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# ─── Stage 2: Python gateway ───
FROM python:3.12-slim

WORKDIR /app

# System deps for PyTorch and ZMQ
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ libzmq3-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.gateway.txt .
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.gateway.txt

COPY gateway_service.py .
COPY dashboard.html .

# Copy built React app
COPY --from=frontend-build /build/dist ./frontend_dist/

EXPOSE 8000

CMD ["uvicorn", "gateway_service:app", "--host", "0.0.0.0", "--port", "8000"]
