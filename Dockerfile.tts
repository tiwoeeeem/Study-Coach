FROM python:3.12-slim

WORKDIR /app

# System deps for ZMQ
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ libzmq3-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.tts.txt .
RUN pip install --no-cache-dir -r requirements.tts.txt

COPY tts_worker.py .

EXPOSE 5556

CMD ["python", "tts_worker.py"]
